# ===== Backend (Spring Boot) =====
# Copy file này thành .env ở thư mục gốc rồi điền giá trị thật.
# Backend đọc các biến sau (xem backend/src/main/resources/application.properties)

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/wareflow?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=30063008

# --- JWT ---
# Chuỗi bí mật, tối thiểu 256 bit. KHÔNG dùng giá trị mặc định ở production.
JWT_SECRET=wareflow-team8-super-secret-key-for-jwt-signing-2026-must-be-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dữ liệu seed mặc định (tắt bằng SEED_ENABLED=false ở production) ---
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@wareflow.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_OWNER_EMAIL=owner@wareflow.com
SEED_OWNER_PASSWORD=Owner@123

# ===== Frontend (Vite) =====
# VITE_ prefixed biến được expose ra client, KHÔNG dùng cho secret.
VITE_API_BASE_URL=http://localhost:8081
